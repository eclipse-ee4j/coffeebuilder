<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         child.project.url.inherit.append.path="false"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.eclipse.coffeebuilder</groupId>
    <artifactId>coffeebuilder-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Eclipse Coffee Builder</name>
    <description>Parent and reactor project for Eclipse Coffee Builder.</description>
    <url>https://projects.eclipse.org/projects/ee4j.coffeebuilder</url>

    <organization>
        <name>Eclipse Foundation</name>
        <url>https://projects.eclipse.org/projects/ee4j.coffeebuilder</url>
    </organization>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/eclipse-ee4j/coffeebuilder.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/eclipse-ee4j/coffeebuilder.git</developerConnection>
        <url>https://github.com/eclipse-ee4j/coffeebuilder</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <modules>
        <module>coffee-builder-maven-plugin</module>
        <module>jakarta-ee-minimal-archetype</module>
    </modules>
</project>
